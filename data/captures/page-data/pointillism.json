en credit on the exhibition label.</p>\n\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\">TO INTERACT:<br class=\"wixui-rich-text__text\">\n- Click on the canvas to start the first painting&nbsp;<br class=\"wixui-rich-text__text\">\n- Slide the bar to adjust the size of the stroke instantly<br class=\"wixui-rich-text__text\">\n- After 10 seconds, the current canvas will be complete. The user will be given the choice to save this final artwork to local computer<br class=\"wixui-rich-text__text\">\n- Click space&nbsp;to clear the canvas and start a new painting&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\"><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://openprocessing.org/sketch/965852\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">View / Run Source Code</span></a></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-la4l9p6k":{"containerProps":{"containerLayoutClassName":"comp-la4l9p6k-container","overlowWrapperClassName":"comp-la4l9p6k-overflow-wrapper","hasScrollOverflow":true,"hasOverflow":true,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"containerRootClassName":"","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-la4l9p6k_relative":{"containerLayoutClassName":"comp-la4l9p6k-container","overlowWrapperClassName":"comp-la4l9p6k-overflow-wrapper","hasScrollOverflow":true,"hasOverflow":true,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-la4l9p6m4":{"src":"https://vimeo.com/638218379","title":"","loop":false,"controls":true,"showTitle":false,"playableCo